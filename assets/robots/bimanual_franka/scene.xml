<mujoco model="fr3_duo_scene">
  <include file="fr3_duo.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <statistic center="0 0 0.5" extent="1.5"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <material name="groundplane" rgba="1 1 1 1" specular="0" shininess="0" reflectance="0"/>

    <!-- Live camera-stream slots: textures overwritten at runtime by viz.py;
         emission=1 makes them render at full brightness like a display screen. -->
    <texture name="cam_left_wrist_tex"  type="2d" builtin="flat" rgb1="0.18 0.18 0.18" width="640" height="360"/>
    <texture name="cam_right_wrist_tex" type="2d" builtin="flat" rgb1="0.18 0.18 0.18" width="640" height="360"/>
    <texture name="cam_head_zed_tex"    type="2d" builtin="flat" rgb1="0.18 0.18 0.18" width="640" height="360"/>
    <material name="cam_left_wrist_mat"  texture="cam_left_wrist_tex"  emission="1.0" specular="0" shininess="0"/>
    <material name="cam_right_wrist_mat" texture="cam_right_wrist_tex" emission="1.0" specular="0" shininess="0"/>
    <material name="cam_head_zed_mat"    texture="cam_head_zed_tex"    emission="1.0" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 -0.3" size="3 3 0.01" material="groundplane" conaffinity="1" contype="1"/>
  </worldbody>
</mujoco>
